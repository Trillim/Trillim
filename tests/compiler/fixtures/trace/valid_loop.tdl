from trillim.tdl import *

with Graph() as graph:
    limit = Input(name="limit", shape=(), dtype="int64")
    history = Cache(name="history", shape=(4,), dtype="int64", mode="append", axis=0)

    def body(state: tuple[Tensor, ...]) -> tuple[Tensor, ...]:
        history.append(Reshape(state[0], (1,)))
        return (Add(state[0], 1),)

    While(
        (Constant(0),),
        condition=lambda state: Compare(state[0], limit, predicate="lt"),
        body=body,
    )
    Output(history.read(), name="history")
